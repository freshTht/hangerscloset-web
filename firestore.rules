rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: allowed_users
    // Document ID: email (lowercase, e.g. "fresh.thit@gmail.com")
    // Fields:
    //   - email: string (required) - User email address
    //   - enabled: bool (optional, defaults to true) - Active status
    //   - role: string (optional) - e.g. "admin", "staff"
    //
    // Collection: inventory
    // Document ID: itemId (or clothing code, e.g. "AVL01")
    // Fields:
    //   - name: string (required, 1..200 chars) - Display name of apparel item
    //   - code: string (required, 1..30 chars) - Stock item code
    //   - brand: string (required, 0..100 chars) - Brand name
    //   - color: string (required, 0..100 chars) - Color description
    //   - size: string (required, 0..20 chars) - Clothing size (e.g. S, M, L)
    //   - type: string (optional, 0..100 chars) - Category / dress type (legacy / primary tag)
    //   - tags: list (optional, 0..30 items) - Multiple category tags
    //   - note: string | null (optional, 0..2000 chars) - Free-text notes
    //   - accessories: string | null (optional, 0..200 chars) - Included accessories
    //   - owner: string | null (optional, 0..100 chars) - Consignor / owner indicator
    //   - imageFile: string (optional, 0..200 chars) - Source file name
    //   - imageUrl: string (required, 0..700000 chars) - Empty (no image), asset/Storage URL,
    //       or a downscaled JPEG data URL (kept well under the 1 MiB document limit)
    //   - rentalPrices: list (required, 1..20 items)
    //       - list of tiers: [{ durationDays: number, price: number }]
    //   - status: string (required, enum ['available', 'reserved', 'laundry'])
    //
    // Collections: brands, colors, sizes, tags
    // Document ID: encoded option key (e.g. "feelfree", "free_size")
    // Fields:
    //   - name: string (required, 1..100 chars) - Display name of the option
    //
    // ===============================================================

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Authenticated, verified user whose (lowercased) email has an allowed_users entry
    // that is not explicitly disabled (mirrors the client-side access check).
    function isAllowedUser() {
      return isAuthenticated() &&
        request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())) &&
        get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data.get('enabled', true) != false;
    }

    function isValidStatus(status) {
      return status in ['available', 'reserved', 'laundry'];
    }

    function isValidPrices(prices) {
      return prices is list && prices.size() > 0 && prices.size() <= 20;
    }

    function isValidInventoryItem(data) {
      let requiredFields = ['name', 'code', 'brand', 'color', 'size', 'imageUrl', 'rentalPrices', 'status'];
      let allowedFields = [
        'name', 'code', 'brand', 'color', 'size', 'type', 'tags', 'note',
        'accessories', 'owner', 'imageFile', 'imageUrl', 'rentalPrices', 'status'
      ];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
        data.brand is string && data.brand.size() <= 100 &&
        data.color is string && data.color.size() <= 100 &&
        data.size is string && data.size.size() <= 20 &&
        (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
        (!('tags' in data) || (data.tags is list && data.tags.size() <= 30)) &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000)) &&
        (!('accessories' in data) || data.accessories == null || (data.accessories is string && data.accessories.size() <= 200)) &&
        (!('owner' in data) || data.owner == null || (data.owner is string && data.owner.size() <= 100)) &&
        (!('imageFile' in data) || (data.imageFile is string && data.imageFile.size() <= 200)) &&
        data.imageUrl is string && data.imageUrl.size() <= 700000 &&
        isValidPrices(data.rentalPrices) &&
        isValidStatus(data.status);
    }

    function isValidMetadataItem(data) {
      let requiredFields = ['name'];
      let allowedFields = ['name'];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 100;
    }

    function isValidCustomer(data) {
      let requiredFields = ['name', 'phone', 'createdAt'];
      let allowedFields = ['name', 'phone', 'lineId', 'note', 'createdAt'];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.phone is string && data.phone.size() > 0 && data.phone.size() <= 40 &&
        (!('lineId' in data) || data.lineId == null || (data.lineId is string && data.lineId.size() <= 100)) &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000)) &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 60;
    }

    function isValidBooking(data) {
      let requiredFields = [
        'customerId', 'customerName', 'customerPhone', 'items',
        'startDate', 'endDate', 'cleaningEndDate', 'durationDays',
        'rentalPrice', 'deposit', 'depositRefunded', 'createdAt', 'updatedAt'
      ];
      let allowedFields = [
        'customerId', 'customerName', 'customerPhone', 'customerLineId',
        'items', 'startDate', 'endDate', 'cleaningEndDate', 'durationDays',
        'rentalPrice', 'deposit', 'depositRefunded', 'note', 'createdAt', 'updatedAt'
      ];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.customerId is string && data.customerId.size() > 0 && data.customerId.size() <= 100 &&
        data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200 &&
        data.customerPhone is string && data.customerPhone.size() > 0 && data.customerPhone.size() <= 40 &&
        (!('customerLineId' in data) || data.customerLineId == null || (data.customerLineId is string && data.customerLineId.size() <= 100)) &&
        data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
        data.startDate is string && data.startDate.size() == 10 &&
        data.endDate is string && data.endDate.size() == 10 &&
        data.cleaningEndDate is string && data.cleaningEndDate.size() == 10 &&
        data.durationDays is number && data.durationDays >= 1 &&
        data.rentalPrice is number && data.rentalPrice >= 0 &&
        data.deposit is number && data.deposit >= 0 &&
        data.depositRefunded is bool &&
        (!('note' in data) || data.note == null || (data.note is string && data.note.size() <= 2000)) &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 60 &&
        data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 60;
    }

    // ===============================================================
    // Collection: allowed_users
    // ===============================================================
    match /allowed_users/{email} {
      // Authenticated users can check their own email entry to determine authorization
      allow get: if isAuthenticated() && request.auth.token.email == email;
      // Modifications to allowed_users are restricted to administrative tools
      allow write: if false;
    }

    // ===============================================================
    // Collection: inventory
    // ===============================================================
    match /inventory/{itemId} {
      // Only users in the allowed_users collection can read or modify inventory
      allow read: if isAllowedUser();

      allow create: if isAllowedUser() && isValidInventoryItem(request.resource.data);

      // The SKU code is editable (documents are keyed by auto-ID, not by code)
      allow update: if isAllowedUser() &&
        isValidInventoryItem(request.resource.data);

      allow delete: if isAllowedUser();
    }

    // ===============================================================
    // Collections: brands, colors, sizes, tags (Metadata)
    // ===============================================================
    match /brands/{id} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidMetadataItem(request.resource.data);
      allow delete: if isAllowedUser();
    }

    match /colors/{id} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidMetadataItem(request.resource.data);
      allow delete: if isAllowedUser();
    }

    match /sizes/{id} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidMetadataItem(request.resource.data);
      allow delete: if isAllowedUser();
    }

    match /tags/{id} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidMetadataItem(request.resource.data);
      allow delete: if isAllowedUser();
    }

    // ===============================================================
    // Collection: customers
    // ===============================================================
    match /customers/{customerId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidCustomer(request.resource.data);
      allow delete: if isAllowedUser();
    }

    // ===============================================================
    // Collection: bookings
    // ===============================================================
    match /bookings/{bookingId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser() && isValidBooking(request.resource.data);
      allow delete: if isAllowedUser();
    }
  }
}
