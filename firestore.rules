rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: allowed_users
    // Document ID: email (lowercase, e.g. "fresh.thit@gmail.com")
    // Fields:
    //   - email: string (required) - User email address
    //   - enabled: bool (optional, defaults to true) - Active status
    //   - role: string (optional) - e.g. "admin", "staff"
    //
    // Collection: inventory
    // Document ID: itemId (or clothing code, e.g. "AVL01")
    // Fields:
    //   - name: string (required, 1..200 chars) - Display name of apparel item
    //   - code: string (required, 1..30 chars, immutable on update) - Stock item code
    //   - brand: string (required, 0..100 chars) - Brand name
    //   - color: string (required, 0..100 chars) - Color description
    //   - size: string (required, 0..20 chars) - Clothing size (e.g. S, M, L)
    //   - type: string (optional, 0..100 chars) - Category / dress type
    //   - accessories: string | null (optional, 0..200 chars) - Included accessories
    //   - owner: string | null (optional, 0..100 chars) - Consignor / owner indicator
    //   - imageFile: string (optional, 0..200 chars) - Source file name
    //   - imageUrl: string (required, 1..1000 chars) - Asset URL or Storage download URL
    //   - rentalPrices: map (required)
    //       - oneDay: number (>= 0, <= 100000) - 1 day rental price
    //       - threeDays: number (>= 0, <= 100000) - 3 days rental price
    //       - fiveDays: number (>= 0, <= 100000) - 5 days rental price
    //   - status: string (required, enum ['available', 'reserved', 'laundry'])
    //
    // ===============================================================

    // Default deny for all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user's email exists in the allowed_users collection
    function isAllowedUser() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/allowed_users/$(request.auth.token.email))
      );
    }

    function isValidStatus(status) {
      return status in ['available', 'reserved', 'laundry'];
    }

    function isValidPrices(prices) {
      return prices is map &&
        prices.keys().hasAll(['oneDay', 'threeDays', 'fiveDays']) &&
        prices.keys().hasOnly(['oneDay', 'threeDays', 'fiveDays']) &&
        prices.oneDay is number && prices.oneDay >= 0 && prices.oneDay <= 100000 &&
        prices.threeDays is number && prices.threeDays >= 0 && prices.threeDays <= 100000 &&
        prices.fiveDays is number && prices.fiveDays >= 0 && prices.fiveDays <= 100000;
    }

    function isValidInventoryItem(data) {
      let requiredFields = ['name', 'code', 'brand', 'color', 'size', 'imageUrl', 'rentalPrices', 'status'];
      let allowedFields = ['name', 'code', 'brand', 'color', 'size', 'type', 'accessories', 'owner', 'imageFile', 'imageUrl', 'rentalPrices', 'status'];

      return data.keys().hasAll(requiredFields) &&
        data.keys().hasOnly(allowedFields) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
        data.code is string && data.code.size() > 0 && data.code.size() <= 30 &&
        data.brand is string && data.brand.size() <= 100 &&
        data.color is string && data.color.size() <= 100 &&
        data.size is string && data.size.size() <= 20 &&
        (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
        (!('accessories' in data) || data.accessories == null || (data.accessories is string && data.accessories.size() <= 200)) &&
        (!('owner' in data) || data.owner == null || (data.owner is string && data.owner.size() <= 100)) &&
        (!('imageFile' in data) || (data.imageFile is string && data.imageFile.size() <= 200)) &&
        data.imageUrl is string && data.imageUrl.size() > 0 && data.imageUrl.size() <= 1000 &&
        isValidPrices(data.rentalPrices) &&
        isValidStatus(data.status);
    }

    // ===============================================================
    // Collection: allowed_users
    // ===============================================================
    match /allowed_users/{email} {
      // Authenticated users can check their own email entry to determine authorization
      allow get: if isAuthenticated() && request.auth.token.email == email;
      // Modifications to allowed_users are restricted to administrative tools
      allow write: if false;
    }

    // ===============================================================
    // Collection: inventory
    // ===============================================================
    match /inventory/{itemId} {
      // Only users in the allowed_users collection can read or modify inventory
      allow read: if isAllowedUser();

      allow create: if isAllowedUser() && isValidInventoryItem(request.resource.data);

      allow update: if isAllowedUser() &&
        isValidInventoryItem(request.resource.data) &&
        request.resource.data.code == resource.data.code;

      allow delete: if isAllowedUser();
    }
  }
}
