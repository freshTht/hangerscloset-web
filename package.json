{
  "name": "hangerscloset-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:mock": "vite --mode mock",
    "dev:firebase": "vite --mode firebase",
    "build": "tsc -b && vite build --mode mock",
    "build:mock": "tsc -b && vite build --mode mock",
    "build:firebase": "tsc -b && vite build --mode firebase",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:firestore": "node scripts/seedFirestore.mjs",
    "deploy:rules": "npx --yes firebase-tools deploy --only firestore:rules",
    "deploy:storage-rules": "npx --yes firebase-tools deploy --only storage",
    "postinstall": "node scripts/updateBeerCssDocs.mjs",
    "update:beercss-docs": "node scripts/updateBeerCssDocs.mjs"
  },
  "dependencies": {
    "beercss": "^3.8.0",
    "material-dynamic-colors": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase": "^13.1.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "vitest": "^5.0.5"
  }
}
